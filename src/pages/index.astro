---
import { listEnrolments, listMessages } from "../lib/db";
import "../styles.css";

const messages = listMessages();
const enrolments = listEnrolments();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>COMP4020 prototype</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Guestbook</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Guestbook</h1>
      <p>
        A minimal full-stack starter: messages live in SQLite on the machine's
        volume (state survives a reload and a redeploy), and new messages
        appear in every open tab over a server-sent-events stream — open this
        page twice and sign it in one. Replace all of this with your own
        prototype.
      </p>
      <form method="post" action="/api/messages">
        <label for="body">Leave a message</label>
        <input id="body" name="body" required maxlength="500" />
        <button>Sign</button>
      </form>
      <ul id="messages">
        {messages.map((message) => <li>{message.body}</li>)}
      </ul>

      <h2>Timetable plan</h2>
      <p>
        Add a course and session to your plan. It's stored in SQLite, so it's
        still here after a reload.
      </p>
      <form method="post" action="/api/enrolments">
        <label for="courseCode">Course code</label>
        <input id="courseCode" name="courseCode" required maxlength="50" />
        <label for="session">Session</label>
        <input id="session" name="session" required maxlength="100" />
        <button>Add to plan</button>
      </form>
      <ul id="enrolments">
        {
          enrolments.map((enrolment) => (
            <li>
              {enrolment.courseCode} &mdash; {enrolment.session}
            </li>
          ))
        }
      </ul>
    </main>
    <script>
      // The live half of the demo: subscribe to the SSE stream and prepend
      // messages as they arrive. The form itself needs none of this — its
      // POST + redirect re-renders the submitting tab from SQLite; this
      // stream is how every other tab finds out.
      const list = document.querySelector("#messages");
      const source = new EventSource("/api/events");
      source.addEventListener("message", (event) => {
        const message = JSON.parse(event.data);
        const item = document.createElement("li");
        item.textContent = message.body;
        list?.prepend(item);
      });
    </script>
  </body>
</html>
