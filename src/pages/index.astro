---
import { listEnrolments } from "../lib/db";
import { coursesByCode, courses, planSessions } from "../lib/courses";
import { CAPSTONE_OPTIONS, SPECIALISATIONS, buildChecklist, findViolations } from "../lib/requirements";
import "../styles.css";

const enrolments = listEnrolments();

// Every semester the planner offers as a column, plus any session a past
// enrolment used that isn't one of them (so nothing typed in before this
// table existed silently disappears).
const sessions = [
  ...planSessions(),
  ...new Set(enrolments.map((e) => e.session).filter((s) => !planSessions().includes(s))),
];

const bySession = new Map(sessions.map((s) => [s, enrolments.filter((e) => e.session === s)]));
const rowCount = Math.max(4, ...sessions.map((s) => bySession.get(s)!.length));
const FULL_LOAD_UNITS = 24;

function unitsFor(session: string): number {
  return bySession
    .get(session)!
    .reduce((sum, e) => sum + (coursesByCode.get(e.courseCode)?.units ?? 0), 0);
}

// Which specialisation/capstone the requirements checklist checks against —
// picked via a plain GET form, so the choice survives a reload without JS.
const specialisationKey = Astro.url.searchParams.get("specialisation") ?? SPECIALISATIONS[0].key;
const capstoneKey = Astro.url.searchParams.get("capstone") ?? CAPSTONE_OPTIONS[0].key;

const violations = findViolations(enrolments);
const violationsByCell = new Map<string, string[]>();
for (const v of violations) {
  const key = `${v.courseCode}__${v.session}`;
  violationsByCell.set(key, [...(violationsByCell.get(key) ?? []), v.suggestion]);
}

const { rows: checklistRows } = buildChecklist(enrolments, specialisationKey, capstoneKey);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>COMP4020 prototype</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Plan</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Timetable plan</h1>
      <p>
        Add a course to a semester. It's stored in SQLite, so it's still here
        after a reload.
      </p>
      <form method="post" action="/api/enrolments">
        <label for="courseCode">Course</label>
        <select id="courseCode" name="courseCode" required>
          <option value="" selected disabled>Choose a course&hellip;</option>
          {
            courses.map((course) => (
              <option value={course.code}>
                {course.code} &mdash; {course.title} ({course.units} units)
              </option>
            ))
          }
        </select>
        <label for="session">Semester</label>
        <select id="session" name="session" required>
          <option value="" selected disabled>Choose a semester&hellip;</option>
          {planSessions().map((session) => <option value={session}>{session}</option>)}
        </select>
        <button>Add to plan</button>
      </form>

      <table class="planner">
        <caption>Degree plan, {sessions[0]} &ndash; {sessions[sessions.length - 1]}</caption>
        <thead>
          <tr>
            <th scope="col">Course</th>
            {sessions.map((session) => <th scope="col">{session}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            Array.from({ length: rowCount }, (_, row) => (
              <tr>
                <th scope="row">{row + 1}</th>
                {sessions.map((session) => {
                  const enrolment = bySession.get(session)![row];
                  const course = enrolment && coursesByCode.get(enrolment.courseCode);
                  const cellViolations = enrolment ? violationsByCell.get(`${enrolment.courseCode}__${session}`) : undefined;
                  return (
                    <td class={cellViolations ? "violation" : ""} title={cellViolations?.join(" ")}>
                      {enrolment && (
                        <div class="cell-enrolment">
                          <span>{course ? `${course.code} — ${course.title}` : enrolment.courseCode}</span>
                          <form method="post" action={`/api/enrolments/${enrolment.id}`}>
                            <button type="submit" aria-label={`Remove ${enrolment.courseCode} from ${session}`}>
                              Remove
                            </button>
                          </form>
                        </div>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">Units</th>
            {
              sessions.map((session) => {
                const units = unitsFor(session);
                return <td class={units > FULL_LOAD_UNITS ? "overload" : ""}>{units}</td>;
              })
            }
          </tr>
        </tfoot>
      </table>

      {
        violations.length > 0 && (
          <div class="violations" role="alert">
            <h3>Out of sequence</h3>
            <ul>
              {violations.map((v) => (
                <li>
                  <strong>{v.courseCode}</strong> ({v.session}): {v.message} {v.suggestion}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <h2>Program requirements</h2>
      <p>Bachelor of Advanced Computing (Honours) — checked against the courses in your plan above.</p>
      <form method="get" action="/">
        <label for="specialisation">Specialisation</label>
        <select id="specialisation" name="specialisation">
          {
            SPECIALISATIONS.map((s) => (
              <option value={s.key} selected={s.key === specialisationKey}>
                {s.name}
              </option>
            ))
          }
        </select>
        <label for="capstone">Capstone</label>
        <select id="capstone" name="capstone">
          {
            CAPSTONE_OPTIONS.map((c) => (
              <option value={c.key} selected={c.key === capstoneKey}>
                {c.name}
              </option>
            ))
          }
        </select>
        <button>Update checklist</button>
      </form>
      <table class="planner checklist">
        <thead>
          <tr>
            <th scope="col">Requirement</th>
            <th scope="col">Units</th>
            <th scope="col">Status</th>
            <th scope="col">Detail</th>
          </tr>
        </thead>
        <tbody>
          {
            checklistRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>
                  {row.unitsCompleted}/{row.unitsRequired}
                </td>
                <td class={row.done ? "done" : "not-done"}>{row.done ? "✓ done" : "not yet"}</td>
                <td>{row.detail}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </main>
  </body>
</html>
